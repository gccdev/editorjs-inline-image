{
  "name": "editorjs-inline-image",
  "version": "0.1.1",
  "keywords": [
    "tool",
    "image",
    "server-less",
    "editor.js",
    "editorjs"
  ],
  "description": "InlineImage Tool for Editor.js",
  "license": "MIT",
  "repository": "https://github.com/kommitters/editorjs-inline-image",
  "main": "./dist/bundle.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development --watch",
    "test": "jest"
  },
  "author": {
    "name": "kommit",
    "email": "info@kommit.co"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@testing-library/jest-dom": "^7.0.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "eslint": "^7.1.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.20.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "nock": "^14.0.17",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/test/config/setupTests.js"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest",
      "^.+\\.(css|svg)$": "<rootDir>/test/config/assetsTransform.js"
    },
    "testEnvironment": "jsdom"
  }
